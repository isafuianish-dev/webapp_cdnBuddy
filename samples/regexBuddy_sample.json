{
  "patterns": [
    { "name": "Email address", "pattern": "[\\w.+-]+@[\\w-]+\\.[a-zA-Z]{2,}", "flags": "g" },
    { "name": "URL", "pattern": "https?:\\/\\/[\\w.-]+(?:\\.[a-zA-Z]{2,})+(?:[\\/\\w#?&=.%-]*)*", "flags": "g" },
    { "name": "IPv4 address", "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b", "flags": "g" },
    { "name": "IPv6 address", "pattern": "\\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\\b", "flags": "gi" },
    { "name": "US phone number", "pattern": "\\(?\\d{3}\\)?[-. ]?\\d{3}[-. ]?\\d{4}", "flags": "g" },
    { "name": "International phone number (E.164)", "pattern": "\\+[1-9]\\d{7,14}\\b", "flags": "g" },
    { "name": "Hex color", "pattern": "#(?:[0-9a-fA-F]{3}){1,2}\\b", "flags": "gi" },
    { "name": "RGB color", "pattern": "rgb\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*\\)", "flags": "gi" },
    { "name": "Date (YYYY-MM-DD)", "pattern": "\\b\\d{4}-\\d{2}-\\d{2}\\b", "flags": "g" },
    { "name": "Date (MM/DD/YYYY)", "pattern": "\\b(0?[1-9]|1[0-2])\\/(0?[1-9]|[12]\\d|3[01])\\/\\d{4}\\b", "flags": "g" },
    { "name": "Time (24-hour HH:MM)", "pattern": "\\b([01]\\d|2[0-3]):[0-5]\\d\\b", "flags": "g" },
    { "name": "Whitespace runs", "pattern": "\\s+", "flags": "g" },
    { "name": "Digits only (whole string)", "pattern": "^\\d+$", "flags": "" },
    { "name": "Decimal number", "pattern": "-?\\d+(?:\\.\\d+)?", "flags": "g" },
    { "name": "HTML tag", "pattern": "<\\/?[a-zA-Z][^>]*>", "flags": "g" },
    { "name": "HTML comment", "pattern": "<!--[\\s\\S]*?-->", "flags": "g" },
    { "name": "Leading/trailing whitespace", "pattern": "^\\s+|\\s+$", "flags": "g" },
    { "name": "Username (3-16 chars)", "pattern": "^[a-zA-Z0-9_]{3,16}$", "flags": "" },
    { "name": "Strong password", "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^\\w\\s]).{8,}$", "flags": "" },
    { "name": "Slug (kebab-case)", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "flags": "" },
    { "name": "Snake_case", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$", "flags": "" },
    { "name": "camelCase", "pattern": "^[a-z]+(?:[A-Z][a-z0-9]*)*$", "flags": "" },
    { "name": "PascalCase", "pattern": "^[A-Z][a-zA-Z0-9]*$", "flags": "" },
    { "name": "Hashtag", "pattern": "#[a-zA-Z0-9_]+", "flags": "g" },
    { "name": "Mention (@username)", "pattern": "@[a-zA-Z0-9_]+", "flags": "g" },
    { "name": "Zip code (US)", "pattern": "^\\d{5}(?:-\\d{4})?$", "flags": "" },
    { "name": "UK postcode", "pattern": "^[A-Z]{1,2}\\d[A-Z\\d]?\\s?\\d[A-Z]{2}$", "flags": "i" },
    { "name": "MAC address", "pattern": "\\b[0-9A-Fa-f]{2}(?:[:-][0-9A-Fa-f]{2}){5}\\b", "flags": "g" },
    { "name": "UUID", "pattern": "\\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\b", "flags": "gi" },
    { "name": "File extension", "pattern": "\\.[0-9a-zA-Z]+$", "flags": "" },
    { "name": "Markdown link", "pattern": "\\[([^\\]]+)\\]\\(([^)]+)\\)", "flags": "g" },
    { "name": "Markdown image", "pattern": "!\\[([^\\]]*)\\]\\(([^)]+)\\)", "flags": "g" },
    { "name": "Duplicate word", "pattern": "\\b(\\w+)\\s+\\1\\b", "flags": "gi" },
    { "name": "Non-ASCII characters", "pattern": "[^\\x00-\\x7F]+", "flags": "g" },
    { "name": "Credit card (basic)", "pattern": "^(?:\\d[ -]*?){13,16}$", "flags": "" }
  ]
}
